# Copy this file to .env.local and fill in the values

# Google Service Account JSON — paste the entire JSON object as a single line
# Create a service account at https://console.cloud.google.com/iam-admin/serviceaccounts
# Then share the Google Sheet with the service account email
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# The Google Sheet ID — found in the sheet URL:
# https://docs.google.com/spreadsheets/d/[THIS_PART]/edit
SHEET_ID=1M2iy4aVlUZJrJ34t4Y2qSGYgzYXRWCDWzVUtM08MnwM
